# pillar.example — overstate_cis tunables. CIS DIL v2.0.0. Salt 3008.
overstate_cis:
  # Enforcement master switch. False = audit-only (default, safe).
  enforce: False
  # CIS level: 1 skips L2 controls entirely; 2 enables L2 blocks (each still needs per-flag opt-in).
  level: 1

  # Per-control master toggles. Every control defaults to True (enabled).
  # Set a key to False to turn that control OFF — the conflict-avoidance switch
  # (e.g. containers without grub tooling -> grub: False; WiFi laptops ->
  # wireless: False; hosts that keep AppArmor -> selinux: False). This is
  # layered ON TOP of the finer opt-in flags below (level + per-flag), so
  # disabling a control there does not change those semantics.
  controls:
    packages_required: True     # install all required hardening packages
    gpg_enforce: True           # dnf/zypp gpgcheck=1
    firewalld: True             # install + enable firewalld, nftables backend
    firewalld_default_zone: True  # firewall-cmd --set-default-zone (conflicts with site zones/Docker)
    firewall_strict_drop: True  # L2 default-zone drop tightening (needs L2 + flag)
    sysctl_kernel: True         # /etc/sysctl.d/99-cis.conf params + apply
    wireless: True              # mask wpa_supplicant (needs disable_wireless)
    ipv6: True                  # IPv6 disable opt-in (needs disable_ipv6)
    mask_services: True         # mask xinetd/avahi/cups/dhcpd/slpd
    cups_socket: True           # mask cups.socket
    postfix_local_only: True    # postfix inet_interfaces=localhost
    password_aging: True        # login.defs PASS_MAX/MIN/WARN days
    faillock: True              # /etc/security/faillock.conf lockout
    tmout: True                 # TMOUT profile (needs L2 + tmout_enable)
    securetty: True             # /etc/securetty 0600
    ctrlaltdel: True            # mask ctrl-alt-del.target (needs L2 + ctrlaltdel_disable)
    sudo: True                  # sudo pkg + sudoers 0440
    cron_perms: True            # cron.allow/crontab 0600
    sshd: True                  # host keys + sshd_config template + sshd service
    pwquality: True             # /etc/security/pwquality.conf
    umask: True                 # umask 027 (needs L2 + umask_restrictive)
    rsyslog: True               # rsyslog pkg + service + 99-cis.conf
    logrotate: True             # logrotate pkg
    journald_persistent: True   # journald Storage=persistent
    auditd: True                # audit pkg + service
    audit_rules: True           # cis.rules + auditd.conf size + augenrules load
    audit_immutable: True       # -e 2 immutable rules (needs L2 + flag)
    passwd_perms: True          # /etc/passwd|group|shadow|gshadow modes
    usb_storage: True           # usb-storage blacklist (needs L2 + usb_disable)
    selinux: True               # SELinux policy + enforcing/targeted + booleans
    grub: True                  # grub cmdline + AppArmor strip + grub.cfg regen
    legacy_migration: True      # AppArmor->SELinux migration suite (needs flag below)
    audit_reports: True         # all read-only audit.sls reporters

  # SELinux booleans, e.g. { httpd_can_network_connect: 'on' }. Applied with persist=True.
  selinux_booleans: {}

  # Legacy AppArmor→SELinux migration. Default False (skipped). Set True ONLY for
  # pre-Feb-2025 / Leap 15.x imports. Masks apparmor, strips kernel params,
  # touches /.autorelabel, requires MANUAL reboot. Both LSMs simultaneously unsupported.
  legacy_apparmor_migration: False

  # sshd_config full CIS k/v overrides (merged over secure defaults in template).
  sshd_options: {}
    # PermitRootLogin: no
    # PasswordAuthentication: no

  # Extra sysctl keys merged over CIS base (see network.sls sysctl_base).
  sysctl: {}
  disable_ipv6: False        # WARNING: breaks Docker/k8s if True
  disable_wireless: True     # False on WiFi laptops
  firewalld_default_zone: public
  firewalld_strict_drop: False  # L2 opt-in: default zone drop (breaks Docker/k8s)

  # Password / session policy
  pass_max_days: 365
  pass_min_days: 1
  pass_warn_age: 7
  pw_minlen: 14
  faillock_deny: 5
  faillock_unlock_time: 900
  tmout: 600
  tmout_enable: False        # L2 opt-in (kills idle shells)
  ctrlaltdel_disable: False  # L2 opt-in (masks ctrl-alt-del.target)
  umask_restrictive: False   # L2 opt-in 027 (breaks GUI/Docker builds)
  usb_disable: False         # L2 opt-in (breaks installers/VMs)
  audit_immutable: False     # L2 opt-in -e 2 (needs reboot to change)
  audit_max_log_file_mb: 50
  audit_ww_files: True       # audit.sls world-writable scan toggle

  # Services to mask (CIS 2.x). Extend via pillar, never AppArmor here.
  mask_services: ['xinetd', 'avahi-daemon', 'cups', 'dhcpd', 'slpd']

  # Remote log server (rsyslog template). Default local.
  log_server: '@localhost'

  # OS-specific overrides (merged in map.jinja). Rarely needed.
  lookup: {}
    # selinux_runtime_managed: True  # SUSE hosts WITH python SELinux bindings
    #   (libselinux-bindings from security:SELinux) to enable selinux.mode/boolean

# Goss test flags (env, not pillar): ENABLE_L2=1 enforces L2 goss skips.
